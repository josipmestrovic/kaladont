{
  "name": "kaladont",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "predev": "pnpm --filter zajednicko build",
    "dev": "pnpm --parallel --filter web --filter posluzitelj dev",
    "build": "pnpm --filter zajednicko build && pnpm --filter web build && pnpm --filter posluzitelj build",
    "test": "pnpm --filter zajednicko build && pnpm --recursive test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
