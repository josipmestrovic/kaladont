# PostgreSQL konekcijski string (lokalno: native instalacija, ne Docker)
BAZA_URL=postgresql://kaladont:kaladont@localhost:5432/kaladont_dev

# Okruženje: development, test, staging ili production
NODE_ENV=development

# Port HTTP poslužitelja
PORT=3000

# Tajna za potpisivanje sesija
SESIJA_TAJNA=promijeni-me

# Resend/Brevo API kljuc (prazno u razvoju - mailovi se ispisuju u konzolu)
EMAIL_API_KLJUC=

# Verificirana adresa pošiljatelja na domeni kaladont.hr
EMAIL_POSILJATELJ=noreply@kaladont.hr

# Javna adresa za poveznice u emailovima (staging: https://staging.kaladont.hr)
JAVNA_ADRESA=http://localhost:3000

# Staging: pune email adrese odvojene zarezom; u razvoju može ostati prazno

# Adresa za notifikacije prijava
DEV_MAIL=dev@example.com

# Email alarmi aplikacijskog nadzora: uključiti tek nakon provjere DEV_MAIL i probnog emaila u adminu.
NADZOR_EMAIL_OMOGUCEN=false
NADZOR_CPU_PRAG=90
NADZOR_RSS_MIB_PRAG=1024
NADZOR_EVENT_LOOP_MS_PRAG=100
NADZOR_HTTP_MS_PRAG=1000

# Prazno u razvoju (analitika iskljucena)
UMAMI_URL=

# Oznake buildu i health endpointu; u razvoju ostaju lokalne zadane vrijednosti
VERZIJA=lokalno
DIGEST=lokalno

# Uključi samo kada isti Fastify proces treba posluživati izgrađeni SvelteKit frontend.
POSLUZUJ_WEB=false

# SAMO za lokalno testiranje: iskljucuje 30s timer poteza (nema automatskog isteka/eliminacije).
# Pravilo od 30 sekundi po potezu (pravila-igre.md) ostaje sluzbeno pravilo igre - ovo je iskljucivo
# razvojna pogodnost da se ne zurite dok testirate. MORA biti "false" ili izbrisano u produkciji.
ONEMOGUCI_TIMER_POTEZA=false

# Odgoda pocetka partije nakon sto se skupi stol (odbrojavanje u cekaonici), u milisekundama.
# Lokalno je zadano 0, staging i produkcija koriste 10000. Ne dirati u produkciji.
# ODGODA_POCETKA_PARTIJE_MS=10000

# Trajanje poteza: lokalno 5000, staging i produkcija 30000.
# TRAJANJE_POTEZA_MS=30000

# Tolerancija kratkog mreznog prekida tijekom aktivne partije, u milisekundama.
# Staging i produkcija zahtijevaju tocno 10000; timer poteza za to vrijeme nastavlja teci.
# TOLERANCIJA_PREKIDA_MS=10000
HTTP_DOKUMENTI_PO_IP_MINUTI=30

# Socket zaštita: handshake po IP-u u 60 sekundi, aktivne veze, privatne sobe i partije.
SOCKET_HANDSHAKE_PO_IP_MINUTI=30
SOCKET_MAKSIMALNO_AKTIVNIH_VEZA=1000
SOCKET_MAKSIMALNO_PRIVATNIH_SOBA=100
SOCKET_MAKSIMALNO_AKTIVNIH_PARTIJA=500
SOCKET_PROZOR_DOGADAJA_MS=60000
SOCKET_DOGADAJI_PO_PROZORU=30

# Botovi i Zagrijavanje (ADR-017). Trening je zadano ukljucen; javni botovi su zadano iskljuceni
# i ukljucuju se zasebno po modu tek nakon staging provjere. Identitete stvara
# `pnpm --filter posluzitelj seed-botova -- --broj=40` (idempotentno, najvise 100).
TRENING_OMOGUCEN=true
BOTOVI_DVOBOJ=false
BOTOVI_CETVEROBOJ=false
MAKSIMALNO_AKTIVNIH_TRENINGA=100
# Politika v2: propust pri fallbacku i namjerni istek samo javnog bota (0-1).
# BOT_VJEROJATNOST_NE_ZNAM=0.1
# BOT_VJEROJATNOST_ISTEKA=0.005
# BOT_VJEROJATNOST_KA=0.05

# PRIVREMENO (dok Faza 6/7 ne donesu pravu admin autentikaciju): shared-secret header za
# POST /admin/rjecnik/dodaj (X-Admin-Kljuc). Zamijeniti pravom auth prije produkcije.
ADMIN_TAJNI_KLJUC=
