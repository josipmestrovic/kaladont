# Jednokratna lokalna CI konfiguracija — kopiraj u .env.ci-local (ne commitaj).
# Ne koristi kaladont_dev, staging ni produkciju.
#
# 1) U PostgreSQL 16 (psql / pgAdmin), kao superuser:
#    CREATE ROLE kaladont_ci_local WITH LOGIN PASSWORD '<lozinka>' CREATEDB;
# 2) Postavi URL na maintenance bazu postgres na loopbacku:

KALADONT_CI_DB_URL=postgresql://kaladont_ci_local:<lozinka>@127.0.0.1:5432/postgres
