{
    email {$CADDY_EMAIL}
}

staging.kaladont.hr {
    encode gzip
    header X-Robots-Tag "noindex, nofollow"

    @zdravlje path /zdravlje
    handle @zdravlje {
        reverse_proxy aplikacija:3000
    }

    handle {
        basic_auth {
            {$STAGING_BASIC_AUTH_KORISNIK} {$STAGING_BASIC_AUTH_HASH}
        }
        reverse_proxy aplikacija:3000
    }
}
