# Primjer /etc/kaladont/backup.env (mode 600, root-only).
# Zamijeni sve __ZAMIJENI_…__ vrijednosti privatno. Ne commitaj stvarne tajne.

COMPOSE_PROJECT_DIR=/opt/kaladont
COMPOSE_DATOTEKA=/opt/kaladont/docker-compose.prod.yml
BAZA_SERVIS=baza
BAZA_IME=kaladont_prod
BAZA_KORISNIK=kaladont
# Nakon bootstrapa Umami baze: UMAMI_BAZA_IME=umami (prazno = samo dump igre)
# UMAMI_BAZA_IME=

AGE_RECIPIENT=__ZAMIJENI_JAVNIM_age1_RECIPIENTOM__

STORAGEBOX_HOST=__ZAMIJENI_STORAGEBOX_HOST__
STORAGEBOX_USER=__ZAMIJENI_PODRACUNOM__
STORAGEBOX_PORT=23
STORAGEBOX_DIR=/home/__ZAMIJENI_PODRACUNOM__/kaladont-produkcija
STORAGEBOX_SSH_KEY=/etc/kaladont/storagebox_id_ed25519
STORAGEBOX_KNOWN_HOSTS=/etc/kaladont/storagebox_known_hosts

HEALTHCHECK_BACKUP_URL=__ZAMIJENI_HEALTHCHECKS_BACKUP_PING_URL__
HEALTHCHECK_DISK_URL=__ZAMIJENI_HEALTHCHECKS_DISK_PING_URL__

DISK_PRAG_POSTOTAK=80
DISK_MOUNT=/
RETENCIJA_DNEVNIH=7
RETENCIJA_TJEDNIH=4
LOKALNI_RADNI_DIR=/var/tmp/kaladont-backup
